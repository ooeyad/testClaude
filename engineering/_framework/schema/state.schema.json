{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Engineering Opportunity state",
  "type": "object",
  "required": ["id", "slug", "title", "tier", "phase", "gates", "context", "updated"],
  "properties": {
    "id": { "type": "string", "pattern": "^EO-[0-9]{3}$" },
    "slug": { "type": "string" },
    "title": { "type": "string" },
    "tier": { "enum": ["quick", "standard", "deep"] },
    "tierReason": { "type": "string", "description": "Checklist items that forced this tier" },
    "phase": { "enum": ["brief", "clarify", "design", "plan", "implement", "review", "ship", "closed"] },
    "branch": { "type": "string" },
    "budgetTokens": { "type": "integer", "description": "Target ceiling for the whole EO" },
    "gates": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["required", "status"],
        "properties": {
          "required": { "type": "boolean" },
          "status": { "enum": ["n/a", "pending", "approved", "rejected"] },
          "by": { "type": "string" },
          "at": { "type": "string" },
          "conditions": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "wp": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^WP-[0-9]{2}$" },
          "title": { "type": "string" },
          "status": { "enum": ["todo", "doing", "blocked", "review", "done"] },
          "touches": { "type": "array", "items": { "type": "string" } },
          "deps": { "type": "array", "items": { "type": "string" } },
          "refs": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "context": {
      "type": "object",
      "description": "Binding read-sets. A role opens nothing outside its list.",
      "properties": {
        "always": { "type": "array", "items": { "type": "string" } },
        "analyst": { "type": "array", "items": { "type": "string" } },
        "architect": { "type": "array", "items": { "type": "string" } },
        "engineer": { "type": "array", "items": { "type": "string" } },
        "reviewer": { "type": "array", "items": { "type": "string" } }
      }
    },
    "openQuestions": { "type": "integer" },
    "ctxGaps": { "type": "array", "items": { "type": "string" } },
    "updated": { "type": "string" }
  }
}
